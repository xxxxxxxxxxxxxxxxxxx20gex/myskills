# Optional environment variables for skills executed by the local Codex CLI.
# The Playground itself uses Codex CLI's local config/auth and does not require
# baseurl or apikey. Copy this file to .env only when a selected skill needs them.
# Never commit the real .env file.
baseurl=https://api.example.com/v1
apikey=replace-with-your-api-key

# Optional: add any skill-specific environment variables below. The Runner
# passes them to Codex CLI and child tools without exposing them to the browser.
# SOME_SKILL_API_TOKEN=replace-with-that-skill-token
